rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function userData() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return doc != null ? doc.data : {};
    }

    function role() {
      return isSignedIn() ? userData().get('role', '') : '';
    }

    function isAdmin()         { return role() == 'admin'; }
    function isReceptionist()  { return role() == 'receptionist'; }
    function isDoctor()        { return role() == 'doctor'; }
    function isPatient()       { return role() == 'patient'; }

    function isStaff()         { return isAdmin() || isReceptionist(); }

    function isApprovedDoctor() {
      return isDoctor() && userData().get('doctorStatus', '') == 'approved';
    }

    // ── users/ ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:  if isSignedIn();
      allow write: if isOwner(userId) || isStaff();

      // Per-user notification sub-collection (slot cancellations, etc.)
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isStaff();
      }

      // FCM device tokens — owner and admin only
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Medical records — patient can read their own; doctor/admin can read all
      match /medicalRecords/{recordId} {
        allow read:          if isOwner(userId) || isApprovedDoctor() || isStaff();
        allow create, update: if isApprovedDoctor() || isAdmin();
        allow delete:         if isAdmin();

        match /prescriptions/{prescriptionId} {
          allow read:  if isOwner(userId) || isApprovedDoctor() || isStaff();
          allow write: if isApprovedDoctor() || isAdmin();
        }

        match /labTests/{labTestId} {
          allow read:  if isOwner(userId) || isApprovedDoctor() || isStaff();
          allow write: if isApprovedDoctor() || isAdmin();
        }
      }
    }

    // ── doctors/ ──────────────────────────────────────────────────────────────

    match /doctors/{doctorId} {
      allow read:  if isSignedIn();
      allow write: if isOwner(doctorId) || isAdmin();

      match /timeSlots/{slotId} {
        allow read:          if isSignedIn();
        allow create, delete: if isOwner(doctorId) && isApprovedDoctor();
        // Booking transactions flip isBooked — any authenticated user may update
        allow update:         if isSignedIn();
      }
    }

    // ── patients/ ─────────────────────────────────────────────────────────────

    match /patients/{patientId} {
      allow read:  if isSignedIn();
      allow write: if isOwner(patientId) || isStaff();
    }

    // ── appointments/ ─────────────────────────────────────────────────────────

    match /appointments/{appointmentId} {
      // Single-doc read: only parties involved or staff
      allow get: if isSignedIn() && (
        resource.data.patientId   == request.auth.uid ||
        resource.data.patientUserId == request.auth.uid ||
        resource.data.doctorId    == request.auth.uid ||
        isStaff()
      );

      // List/count queries: signed-in only — needed for booking availability checks.
      // Individual document data is never exposed via count() aggregations.
      allow list: if isSignedIn();

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || isStaff()
      );

      allow delete: if isStaff();
    }

    // ── bills/ ────────────────────────────────────────────────────────────────

    match /bills/{billId} {
      // get: patient can read their own bill; staff can read any
      allow get:  if isSignedIn() && (
        resource.data.patientId == request.auth.uid || isStaff()
      );
      // list: staff only — patients never query the full bills collection
      allow list: if isStaff();
      allow write: if isStaff();
    }

    // ── specialties/ ──────────────────────────────────────────────────────────

    match /specialties/{specialtyId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── notifications/ ────────────────────────────────────────────────────────
    // Global notification center. Each document has a `userId` field.
    //
    // Firestore cannot evaluate resource.data in list rules, so:
    //   get  → strict ownership check
    //   list → signed-in only (client always queries .where('userId', == uid))

    match /notifications/{notifId} {
      allow get:    if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list:   if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ── notification_queue/ ───────────────────────────────────────────────────
    // Broadcast jobs enqueued by staff and processed in-app.

    match /notification_queue/{jobId} {
      allow read:  if isSignedIn();
      allow write: if isStaff();
    }
  }
}
